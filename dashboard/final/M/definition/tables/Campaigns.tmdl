	partition Campaigns = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\Campaigns.csv"),[Delimiter=",", Columns=8, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers,{{"campaign_id", type text},{"campaign_type", type text},{"start_date", type date},{"end_date", type date},{"partially_observed", type logical},{"households", Int64.Type},{"redemptions", Int64.Type},{"redeeming_households", Int64.Type}},"en-US")
				in
				    Typed

