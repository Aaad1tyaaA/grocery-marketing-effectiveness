table Cohorts
	lineageTag: cf131c1c-c04c-4d69-84a3-97d5e39b065a

	column cohort
		dataType: dateTime
		formatString: MMM yyyy
		lineageTag: 4596e0ec-cb03-4712-9a89-593e40d2fccc
		summarizeBy: none
		sourceColumn: cohort

	column months_since_first
		dataType: int64
		lineageTag: 2ef3b51e-400a-4488-ac89-5be3b39f05ae
		summarizeBy: none
		sourceColumn: months_since_first

	column cohort_size
		dataType: int64
		lineageTag: edd777f7-d41d-4c1e-b3ad-a46b501c6548
		summarizeBy: none
		sourceColumn: cohort_size

	column active
		dataType: int64
		lineageTag: 95eefd97-ef3c-49c0-8a3e-e9e6e10c56a0
		summarizeBy: none
		sourceColumn: active

	column retention
		dataType: double
		formatString: 0.0%;(0.0%);0.0%
		lineageTag: da198184-93b5-4633-bbff-d9a683a9bd46
		summarizeBy: none
		sourceColumn: retention

	partition Cohorts = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\Cohorts.csv"),[Delimiter=",", Columns=5, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers,{{"cohort", type date},{"months_since_first", Int64.Type},{"cohort_size", Int64.Type},{"active", Int64.Type},{"retention", type number}},"en-US")
				in
				    Typed

