	measure 'Email interval' = IF(HASONEVALUE('Email experiment'[arm]),FORMAT(MAX('Email experiment'[ci_low]),"$0.00") & " to " & FORMAT(MAX('Email experiment'[ci_high]),"$0.00"))
		displayFolder: Marketing
