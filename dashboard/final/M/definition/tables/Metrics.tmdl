		displayFolder: Exploration
		lineageTag: 36bd6b1e-753d-471a-adcc-df3a84517718

	measure 'No-email mean spend' = IF(HASONEVALUE('Email experiment'[arm]),MAX('Email experiment'[control_mean]))
		formatString: $0.00;($0.00);$0.00
