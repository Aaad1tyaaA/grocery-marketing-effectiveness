		lineageTag: f1c81c5b-3f4b-472e-8bb0-de2a052db54b

	measure 'Earlier-match lift' = IF(HASONEVALUE(Campaigns[campaign_id]),CALCULATE(MAX('Campaign estimates'[estimate]),'Campaign estimates'[method]="matched_earlier"))
		formatString: $0.00;($0.00);$0.00
		displayFolder: Exploration
		lineageTag: c95673e3-809e-4984-8a98-4bdf4eab00a1

	measure 'Earlier-match interval' = IF(NOT ISBLANK([Earlier-match lift]),FORMAT(CALCULATE(MAX('Campaign estimates'[ci_low]),'Campaign estimates'[method]="matched_earlier"),"$0.00;($0.00)") & " to " & FORMAT(CALCULATE(MAX('Campaign estimates'[ci_high]),'Campaign estimates'[method]="matched_earlier"),"$0.00;($0.00)"))
		displayFolder: Exploration
		lineageTag: bd4359e2-6f22-41dd-a531-0e2348370bd3

	measure 'Analysed campaign audience' = IF(SELECTEDVALUE(Campaigns[campaign_id]) IN {"8","13","18"},MAX(Campaigns[households]))
