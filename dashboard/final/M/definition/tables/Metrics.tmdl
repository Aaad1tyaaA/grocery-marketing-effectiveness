	measure 'Campaign interval colour' = IF(AND(MAX('Campaign estimates'[ci_low])<=0,MAX('Campaign estimates'[ci_high])>=0),"#FFF1CD","#E9F0F6")
		lineageTag: 8da596cb-9071-41ad-89ce-c075765f0076

