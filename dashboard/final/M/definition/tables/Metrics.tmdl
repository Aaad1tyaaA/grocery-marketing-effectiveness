	measure 'Brand sales share' = IF(LEN(TRIM(SELECTEDVALUE(Products[brand],"")))>0,DIVIDE([Sales],CALCULATE([Sales],FILTER(ALLSELECTED(Products[brand]),LEN(TRIM(Products[brand]))>0))))
		formatString: 0.0%
		displayFolder: Decision views
		lineageTag: bffc4fcf-4a0a-424f-917e-c05e2c44df2b

	measure 'Campaign redeeming household rate' = IF(SELECTEDVALUE(Campaigns[campaign_id]) IN {"8","13","18"},DIVIDE(MAX(Campaigns[redeeming_households]),MAX(Campaigns[households])))
		formatString: 0.0%
		displayFolder: Decision views
		lineageTag: 39f24681-1474-4044-ac9f-9033f9d46d3f

	measure 'Earlier intervals excluding zero' = COUNTROWS(FILTER('Campaign estimates','Campaign estimates'[method]="matched_earlier" && ('Campaign estimates'[ci_low]>0 || 'Campaign estimates'[ci_high]<0)))+0
		formatString: 0
		displayFolder: Decision views
