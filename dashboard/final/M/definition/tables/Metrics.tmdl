table Metrics
	lineageTag: f2bb9a1a-d98c-4553-9f1e-f91594baa89d

	measure Sales = SUM(Sales[sales_value])
		formatString: $#,0;($#,0);$0
		displayFolder: Business health
		lineageTag: 36cb9654-9262-48e9-a479-d5fbb8871139

	measure Baskets = DISTINCTCOUNT(Sales[basket_id])
		formatString: #,0
		displayFolder: Business health
		lineageTag: 6479eb03-d495-4e58-9b67-819658b76914

	measure 'Active households' = DISTINCTCOUNT(Sales[household_id])
		formatString: #,0
		displayFolder: Business health
		lineageTag: 2b2cd80e-b8d7-4fb5-b379-f1f7dc038f08

	measure 'Average basket' = DIVIDE([Sales],[Baskets])
		formatString: $0.00;($0.00);$0.00
		displayFolder: Business health
		lineageTag: a73f7cb6-1f8f-43c6-8c50-a5c3e677f974

	measure 'Shelf value' = SUM(Sales[shelf_value])
		formatString: $#,0;($#,0);$0
		displayFolder: Business health
		lineageTag: 6ccc4f5c-4bc9-4c0f-ad37-94d6248be557

	measure 'Discount depth' = DIVIDE(SUM(Sales[retailer_funded_disc]),[Shelf value])
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: Business health
		lineageTag: d7250a60-c09b-4b9e-a933-64276b2da45d

	measure 'Share sold on discount' = DIVIDE(SUM(Sales[discounted_shelf_value]),[Shelf value])
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: Business health
		lineageTag: edc49392-a4a6-4924-8190-77c9ff3db4ea

	measure 'Comparable weekly sales' = IF(SELECTEDVALUE(Weeks[week]) >= 2,[Sales])
		formatString: $#,0;($#,0);$0
		displayFolder: Business health
		lineageTag: e161d52e-f1f1-46ad-b59e-b9e74b02ee39

	measure 'Comparable weekly depth' = IF(SELECTEDVALUE(Weeks[week]) >= 2,[Discount depth])
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: Business health
		lineageTag: 02c1eaef-4d3f-497d-a440-cc4983cf5811

	measure 'Sales previous week' = VAR w=SELECTEDVALUE(Weeks[week]) RETURN IF(w>2,CALCULATE([Sales],REMOVEFILTERS(Weeks),Weeks[week]=w-1))
		formatString: $#,0;($#,0);$0
		displayFolder: Business health
		lineageTag: 3119a996-593c-4042-b43b-478a1c038ff6

	measure 'Sales change WoW' = DIVIDE([Sales]-[Sales previous week],[Sales previous week])
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: Business health
		lineageTag: a15f11a0-1306-483f-b056-78d16d3698a8

	measure 'Category discount share' = IF([Sales]>=10000,[Share sold on discount])
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: Business health
		lineageTag: 3e8833c3-bf33-490a-a959-764741cfc694

	measure 'Category rank' = IF(NOT ISBLANK([Category discount share]),RANKX(FILTER(ALLSELECTED(Products[category_label]),NOT ISBLANK(CALCULATE([Category discount share]))),[Category discount share],,DESC,DENSE))
		formatString: 0
		displayFolder: Business health
		lineageTag: a9a1e96c-5588-4995-945a-a7c6ca4c1750

	measure 'Top category share' = IF([Category rank]<=6,[Category discount share])
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: Business health
		lineageTag: 841803ce-4513-4582-a506-c15b02bca245

	measure 'Customer households' = COUNT(Households[spend])
		formatString: #,0
		displayFolder: Customers
		lineageTag: a61d9daa-f5f0-4f4c-a697-025b01c17053

	measure 'Annual customer spend' = SUM(Households[spend])
		formatString: $#,0;($#,0);$0
		displayFolder: Customers
		lineageTag: 3e7583d0-0043-40de-8b25-15a2ad446db4

	measure 'Segment spend share' = DIVIDE([Annual customer spend],CALCULATE([Annual customer spend],ALLSELECTED(Households[segment])))
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: Customers
		lineageTag: bd734f75-489e-4d7a-90a0-adcc571889a0

	measure 'Cohort retention' = IF(HASONEVALUE(Cohorts[cohort]) && HASONEVALUE(Cohorts[months_since_first]) && SELECTEDVALUE(Cohorts[months_since_first])<=5,MAX(Cohorts[retention]))
		formatString: 0%
		displayFolder: Customers
		lineageTag: b93be316-1417-4125-95ee-71a31c702c33

	measure 'Retention colour' = VAR r=[Cohort retention] RETURN SWITCH(TRUE(),ISBLANK(r),"#FFFFFF",r>=0.9,"#8CB7C5",r>=0.7,"#BAD5DF",r>=0.5,"#DCEAF0","#F1F6F8")
		displayFolder: Customers
		lineageTag: 08eb0145-8adf-4de0-a2e2-57b65af2a588

	measure 'Promotion index' = DIVIDE(SUM('Promotion associations'[observed_units]),SUM('Promotion associations'[expected_baseline_units]))
		formatString: 0.00"×"
		displayFolder: Marketing
		lineageTag: 00d4d449-f61b-404d-8a48-17b2cb594b17

	measure 'Estimated campaign lift' = IF(HASONEVALUE('Campaign estimates'[campaign_id]) && HASONEVALUE('Campaign estimates'[method]),MAX('Campaign estimates'[estimate]))
		formatString: $0.00;($0.00);$0.00
		displayFolder: Marketing
		lineageTag: ea9e263a-dd78-4023-bbb2-32c0fb40787a

	measure 'Campaign interval' = IF(HASONEVALUE('Campaign estimates'[campaign_id]) && HASONEVALUE('Campaign estimates'[method]),FORMAT(MAX('Campaign estimates'[ci_low]),"$0.00;($0.00)") & " to " & FORMAT(MAX('Campaign estimates'[ci_high]),"$0.00;($0.00)"))
		displayFolder: Marketing
		lineageTag: b2b7afa8-3e9c-44d9-863a-305f85ca7dd9

	measure 'Campaign row colour' = IF(SELECTEDVALUE('Campaign estimates'[method])="matched_earlier","#DFEAF5","#FFFFFF")
		displayFolder: Marketing
		lineageTag: 3024daa9-b3b1-4245-a879-fd50ba20b2e7

	measure 'Email spend lift' = IF(HASONEVALUE('Email experiment'[arm]),MAX('Email experiment'[estimate]))
